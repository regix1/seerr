{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "moduleResolution": "node10",
    "ignoreDeprecations": "6.0",
    "outDir": "../dist",
    "noEmit": false,
    "incremental": true,
    "paths": {
      "@server/*": ["./*"]
    }
  },
  "include": ["**/*.ts"]
}
