# Trust Proxy — controls which upstream proxies Express trusts for X-Forwarded-For.
# Valid values:
#   loopback       — trust 127.0.0.1 and ::1 only (default; safe for most installs)
#   uniquelocal    — trust all RFC-1918 private addresses
#   127.0.0.1, ::1 — explicit loopback addresses (same as loopback)
#   10.0.0.0/8     — example: trust a specific CIDR range (set to your reverse-proxy CIDR)
# Leave unset to use the default (loopback).
TRUST_PROXY=loopback
